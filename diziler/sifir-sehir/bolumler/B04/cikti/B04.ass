Dialogue: 0,0:00:00.20,0:00:00.80,Alt,,0,0,0,,Bir şartla.
Dialogue: 0,0:00:01.60,0:00:03.20,Alt,,0,0,0,,Bu köye insan getireceksiniz.
Dialogue: 0,0:00:04.30,0:00:05.20,Alt,,0,0,0,,Kaç kişi?
Dialogue: 0,0:00:05.70,0:00:07.10,Alt,,0,0,0,,Önce bir getirin de…
Dialogue: 0,0:00:08.10,0:00:09.10,Alt,,0,0,0,,Ne oluyor yine?
Dialogue: 0,0:00:10.00,0:00:12.70,Alt,,0,0,0,,Aşkım, nüfus artırmamız gerekiyormuş.
Dialogue: 0,0:00:13.10,0:00:16.40,Alt,,0,0,0,,Rıza, millet köyden şehre kaçıyor.
Dialogue: 0,0:00:16.60,0:00:18.50,Alt,,0,0,0,,Sen insanları buraya nasıl getireceksin?
Dialogue: 0,0:00:18.80,0:00:20.30,Alt,,0,0,0,,Evleri dağıtacağız!
Dialogue: 0,0:00:21.70,0:00:22.70,Alt,,0,0,0,,Kimin evlerini?
Dialogue: 0,0:00:23.50,0:00:25.50,Alt,,0,0,0,,Bizim on iki tane evimiz var ya.
Dialogue: 0,0:00:26.90,0:00:28.30,Alt,,0,0,0,,Biz bir ev almak için
Dialogue: 0,0:00:28.80,0:00:30.20,Alt,,0,0,0,,yıllarca biriktirdik,
Dialogue: 0,0:00:30.40,0:00:32.10,Alt,,0,0,0,,sen şimdi ev mi dağıtıyorsun?
Dialogue: 0,0:00:32.30,0:00:34.90,Alt,,0,0,0,,Aşkım, müşteri kazanma maliyeti diye bir şey var.
Dialogue: 0,0:00:35.30,0:00:37.10,Alt,,0,0,0,,Rıza, kampanyada yanında çay bardağı verilir,
Dialogue: 0,0:00:37.10,0:00:38.90,Alt,,0,0,0,,ev verilmez!
Dialogue: 0,0:00:39.10,0:00:41.10,Alt,,0,0,0,,Yazıyorum. Kira yok, aidat yok,
Dialogue: 0,0:00:41.10,0:00:43.65,Alt,,0,0,0,,trafik yok, komşu problemi yok…
Dialogue: 0,0:00:43.70,0:00:45.50,Alt,,0,0,0,,Market de yok.
Dialogue: 0,0:00:45.90,0:00:47.20,Alt,,0,0,0,,Doğal yaşam!
Dialogue: 0,0:00:48.70,0:00:49.90,Alt,,0,0,0,,Su da bazen yok.
Dialogue: 0,0:00:50.60,0:00:52.10,Alt,,0,0,0,,Sürdürülebilir yaşam!
Dialogue: 0,0:00:53.00,0:00:54.50,Alt,,0,0,0,,İnternet çekiyor mu bari?
Dialogue: 0,0:00:57.60,0:00:59.00,Alt,,0,0,0,,İnternet de yokmuş.
Dialogue: 0,0:00:59.20,0:00:60.00,Alt,,0,0,0,,Harika.
Dialogue: 0,0:01:00.40,0:01:03.60,Alt,,0,0,0,,İnterneti olmayan köye internetten insan getireceğiz.
Dialogue: 0,0:01:04.60,0:01:06.90,Alt,,0,0,0,,Naci'nin taburesinde çeker.
Dialogue: 0,0:01:08.90,0:01:09.70,Alt,,0,0,0,,Çekti!
Dialogue: 0,0:01:10.90,0:01:12.20,Alt,,0,0,0,,Gönderdim!
Dialogue: 0,0:01:12.60,0:01:14.10,Alt,,0,0,0,,Öncekiler de ilan vermişti.
Dialogue: 0,0:01:16.30,0:01:17.40,Alt,,0,0,0,,Başvuru geldi…
Dialogue: 0,0:01:17.50,0:01:18.30,Alt,,0,0,0,,Kaç tane?
Dialogue: 0,0:01:18.50,0:01:20.10,Alt,,0,0,0,,Üç yüz otuz üç.
