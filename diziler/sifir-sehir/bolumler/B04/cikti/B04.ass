Dialogue: 0,0:00:00.25,0:00:01.75,Alt,,0,0,0,,Evleri dağıtacağız!
Dialogue: 0,0:00:02.00,0:00:02.60,Alt,,0,0,0,,Bir şartla.
Dialogue: 0,0:00:03.40,0:00:05.00,Alt,,0,0,0,,Bu köye insan getireceksiniz.
Dialogue: 0,0:00:06.10,0:00:07.00,Alt,,0,0,0,,Kaç kişi?
Dialogue: 0,0:00:07.50,0:00:08.90,Alt,,0,0,0,,Önce bir getirin de…
Dialogue: 0,0:00:09.90,0:00:10.90,Alt,,0,0,0,,Ne oluyor yine?
Dialogue: 0,0:00:11.80,0:00:14.50,Alt,,0,0,0,,Aşkım, nüfus artırmamız gerekiyormuş.
Dialogue: 0,0:00:14.90,0:00:18.20,Alt,,0,0,0,,Rıza, millet köyden şehre kaçıyor.
Dialogue: 0,0:00:18.40,0:00:20.30,Alt,,0,0,0,,Sen insanları buraya nasıl getireceksin?
Dialogue: 0,0:00:20.60,0:00:22.10,Alt,,0,0,0,,Evleri dağıtacağız!
Dialogue: 0,0:00:23.50,0:00:24.50,Alt,,0,0,0,,Kimin evlerini?
Dialogue: 0,0:00:25.30,0:00:27.30,Alt,,0,0,0,,Bizim on iki tane evimiz var ya.
Dialogue: 0,0:00:28.70,0:00:30.10,Alt,,0,0,0,,Biz bir ev almak için
Dialogue: 0,0:00:30.60,0:00:32.00,Alt,,0,0,0,,yıllarca biriktirdik,
Dialogue: 0,0:00:32.20,0:00:33.90,Alt,,0,0,0,,sen şimdi ev mi dağıtıyorsun?
Dialogue: 0,0:00:34.10,0:00:36.70,Alt,,0,0,0,,Aşkım, müşteri kazanma maliyeti diye bir şey var.
Dialogue: 0,0:00:37.10,0:00:38.90,Alt,,0,0,0,,Rıza, kampanyada yanında çay bardağı verilir,
Dialogue: 0,0:00:38.90,0:00:40.70,Alt,,0,0,0,,ev verilmez!
Dialogue: 0,0:00:40.90,0:00:42.90,Alt,,0,0,0,,Yazıyorum. Kira yok, aidat yok,
Dialogue: 0,0:00:42.90,0:00:45.45,Alt,,0,0,0,,trafik yok, komşu problemi yok…
Dialogue: 0,0:00:45.50,0:00:47.30,Alt,,0,0,0,,Market de yok.
Dialogue: 0,0:00:47.70,0:00:49.00,Alt,,0,0,0,,Doğal yaşam!
Dialogue: 0,0:00:50.50,0:00:51.70,Alt,,0,0,0,,Su da bazen yok.
Dialogue: 0,0:00:52.40,0:00:53.90,Alt,,0,0,0,,Sürdürülebilir yaşam!
Dialogue: 0,0:00:54.80,0:00:56.30,Alt,,0,0,0,,İnternet çekiyor mu bari?
Dialogue: 0,0:00:59.40,0:01:00.80,Alt,,0,0,0,,İnternet de yokmuş.
Dialogue: 0,0:01:01.00,0:01:01.80,Alt,,0,0,0,,Harika.
Dialogue: 0,0:01:02.20,0:01:05.40,Alt,,0,0,0,,İnterneti olmayan köye internetten insan getireceğiz.
Dialogue: 0,0:01:06.40,0:01:08.70,Alt,,0,0,0,,Naci'nin taburesinde çeker.
Dialogue: 0,0:01:10.70,0:01:11.50,Alt,,0,0,0,,Çekti!
Dialogue: 0,0:01:12.70,0:01:14.00,Alt,,0,0,0,,Gönderdim!
Dialogue: 0,0:01:14.40,0:01:15.90,Alt,,0,0,0,,Öncekiler de ilan vermişti.
Dialogue: 0,0:01:18.10,0:01:19.20,Alt,,0,0,0,,Başvuru geldi…
Dialogue: 0,0:01:19.30,0:01:20.10,Alt,,0,0,0,,Kaç tane?
Dialogue: 0,0:01:20.30,0:01:21.90,Alt,,0,0,0,,Üç yüz otuz üç.
